{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "/assets/data/open-weights-runs.json"
  },
  "params": [
    {
      "name": "harness",
      "value": "Incalmo",
      "bind": {
        "input": "select",
        "options": [
          "Incalmo",
          "Shell",
          "Artemis"
        ],
        "name": "Harness "
      }
    },
    {
      "name": "stat",
      "value": "mean",
      "bind": {
        "input": "select",
        "options": [
          "mean",
          "total",
          "median",
          "max",
          "min"
        ],
        "labels": [
          "Mean $ / run",
          "Total $",
          "Median $ / run",
          "Most expensive run",
          "Cheapest run"
        ],
        "name": "Statistic "
      }
    }
  ],
  "transform": [
    {
      "filter": "datum.harness === harness"
    },
    {
      "filter": "isValid(datum.cost)"
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "cost",
          "as": "total"
        },
        {
          "op": "mean",
          "field": "cost",
          "as": "mean"
        },
        {
          "op": "median",
          "field": "cost",
          "as": "median"
        },
        {
          "op": "max",
          "field": "cost",
          "as": "max"
        },
        {
          "op": "min",
          "field": "cost",
          "as": "min"
        },
        {
          "op": "count",
          "as": "runs"
        }
      ],
      "groupby": [
        "model",
        "env",
        "hosts"
      ]
    },
    {
      "calculate": "stat === 'mean' ? datum.mean : stat === 'total' ? datum.total : stat === 'median' ? datum.median : stat === 'max' ? datum.max : datum.min",
      "as": "raw"
    },
    {
      "calculate": "isFinite(datum.raw) ? datum.raw : 0",
      "as": "value"
    },
    {
      "calculate": "datum.env + ' (' + datum.hosts + ')'",
      "as": "envLabel"
    },
    {
      "joinaggregate": [
        { "op": "min", "field": "value", "as": "valueMin" },
        { "op": "max", "field": "value", "as": "valueMax" }
      ]
    }
  ],
  "width": "container",
  "height": 360,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": null
      },
      "encoding": {
        "x": {
          "field": "model",
          "type": "nominal",
          "title": null,
          "axis": {
            "orient": "top",
            "labelAngle": 0
          }
        },
        "y": {
          "field": "envLabel",
          "type": "nominal",
          "title": null,
          "sort": {
            "field": "hosts",
            "order": "ascending"
          }
        },
        "color": {
          "field": "value",
          "type": "quantitative",
          "scale": {
            "scheme": "theme-warm"
          },
          "legend": {
            "title": "$",
            "gradientLength": 160,
            "format": "$,.2f"
          }
        },
        "tooltip": [
          {
            "field": "model",
            "title": "Model"
          },
          {
            "field": "envLabel",
            "title": "Environment"
          },
          {
            "field": "value",
            "type": "quantitative",
            "format": "$,.2f",
            "title": "Value"
          },
          {
            "field": "runs",
            "type": "quantitative",
            "title": "Runs"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 11
      },
      "encoding": {
        "x": {
          "field": "model",
          "type": "nominal",
          "title": null,
          "axis": {
            "orient": "top",
            "labelAngle": 0
          }
        },
        "y": {
          "field": "envLabel",
          "type": "nominal",
          "title": null,
          "sort": {
            "field": "hosts",
            "order": "ascending"
          }
        },
        "text": {
          "field": "value",
          "type": "quantitative",
          "format": "$,.2f"
        },
        "comment": [
          "The label sits on its own cell, not on the page, so it follows the",
          "cell rather than the page's ink - but the ramp inverts between",
          "themes, so which ink reads on which end inverts with it. The two",
          "ink-on-warm tokens carry that. Unlike the goals heatmap this scale",
          "has no fixed domain - it is whatever the selected harness and",
          "statistic happen to span - so the crossover is a fraction of the",
          "ramp rather than an absolute value. 0.75 is the best joint choice",
          "across both themes; worst case is about 3.4:1."
        ],
        "color": {
          "condition": {
            "test": "datum.value > datum.valueMin + 0.75 * (datum.valueMax - datum.valueMin)",
            "value": "$ink-on-warm-high"
          },
          "value": "$ink-on-warm-low"
        }
      }
    }
  ],
  "_minMobileWidth": 470
}
