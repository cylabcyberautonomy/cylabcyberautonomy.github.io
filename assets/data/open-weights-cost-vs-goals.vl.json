{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "/assets/data/open-weights-runs.json"
  },
  "transform": [
    {
      "filter": "isValid(datum.cost)"
    },
    {
      "aggregate": [
        {
          "op": "mean",
          "field": "cost",
          "as": "meanCost"
        },
        {
          "op": "mean",
          "field": "exfiltrated",
          "as": "meanGoals"
        },
        {
          "op": "count",
          "as": "runs"
        }
      ],
      "groupby": [
        "model",
        "harness",
        "env",
        "hosts"
      ]
    },
    {
      "calculate": "datum.env + ' (' + datum.hosts + ')'",
      "as": "envLabel"
    }
  ],
  "width": "container",
  "height": 420,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "mark": {
    "type": "point",
    "filled": true,
    "size": 130,
    "opacity": 0.85
  },
  "encoding": {
    "x": {
      "field": "meanCost",
      "type": "quantitative",
      "title": "Mean cost per run ($)",
      "scale": {
        "zero": true
      },
      "axis": {
        "format": "$,.2f"
      }
    },
    "y": {
      "field": "meanGoals",
      "type": "quantitative",
      "title": "Mean % of goals achieved",
      "scale": {
        "domain": [0, 100]
      }
    },
    "color": {
      "field": "model",
      "type": "nominal",
      "title": "Model",
      "sort": ["GLM 5.2", "Kimi K3", "Qwen 3.8 Max"]
    },
    "shape": {
      "field": "harness",
      "type": "nominal",
      "title": "Harness",
      "scale": {
        "domain": ["Incalmo", "Artemis", "Shell"],
        "range": ["circle", "triangle-up", "square"]
      }
    },
    "tooltip": [
      {
        "field": "model",
        "title": "Model"
      },
      {
        "field": "harness",
        "title": "Harness"
      },
      {
        "field": "envLabel",
        "title": "Environment"
      },
      {
        "field": "meanCost",
        "type": "quantitative",
        "format": "$,.2f",
        "title": "Mean cost / run"
      },
      {
        "field": "meanGoals",
        "type": "quantitative",
        "format": ".1f",
        "title": "Mean % goals achieved"
      },
      {
        "field": "runs",
        "type": "quantitative",
        "title": "Runs"
      }
    ]
  }
}
