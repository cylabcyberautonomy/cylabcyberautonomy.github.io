{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "/assets/data/open-weights-runs.json"
  },
  "transform": [
    {
      "filter": "isValid(datum.cost)"
    }
  ],
  "width": "container",
  "height": 420,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "layer": [
    {
      "data": {
        "values": [
          {
            "harness": "Artemis",
            "order": 0,
            "px": 2.02,
            "py": 0.0
          },
          {
            "harness": "Artemis",
            "order": 1,
            "px": 13.501,
            "py": 0.0
          },
          {
            "harness": "Artemis",
            "order": 2,
            "px": 13.937,
            "py": 8.93
          },
          {
            "harness": "Artemis",
            "order": 3,
            "px": 10.758,
            "py": 100.0
          },
          {
            "harness": "Artemis",
            "order": 4,
            "px": 2.058,
            "py": 100.0
          },
          {
            "harness": "Incalmo",
            "order": 0,
            "px": 0.072,
            "py": 100.0
          },
          {
            "harness": "Incalmo",
            "order": 1,
            "px": 0.081,
            "py": 26.333
          },
          {
            "harness": "Incalmo",
            "order": 2,
            "px": 0.086,
            "py": 1.804
          },
          {
            "harness": "Incalmo",
            "order": 3,
            "px": 0.169,
            "py": 0.0
          },
          {
            "harness": "Incalmo",
            "order": 4,
            "px": 2.124,
            "py": 0.0
          },
          {
            "harness": "Incalmo",
            "order": 5,
            "px": 2.189,
            "py": 100.0
          },
          {
            "harness": "Shell",
            "order": 0,
            "px": 0.0,
            "py": 100.0
          },
          {
            "harness": "Shell",
            "order": 1,
            "px": 0.0,
            "py": 0.212
          },
          {
            "harness": "Shell",
            "order": 2,
            "px": 0.0,
            "py": 0.0
          },
          {
            "harness": "Shell",
            "order": 3,
            "px": 8.087,
            "py": 0.0
          },
          {
            "harness": "Shell",
            "order": 4,
            "px": 7.003,
            "py": 97.962
          },
          {
            "harness": "Shell",
            "order": 5,
            "px": 3.339,
            "py": 100.0
          }
        ]
      },
      "mark": {
        "type": "line",
        "interpolate": "cardinal-closed",
        "tension": 0.4,
        "fill": "#898781",
        "fillOpacity": 0.22,
        "stroke": "#898781",
        "strokeOpacity": 0.4,
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "px",
          "type": "quantitative"
        },
        "y": {
          "field": "py",
          "type": "quantitative"
        },
        "detail": {
          "field": "harness",
          "type": "nominal"
        },
        "order": {
          "field": "order",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "harness",
            "title": "Harness"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "mean",
              "field": "cost",
              "as": "meanCost"
            },
            {
              "op": "mean",
              "field": "exfiltrated",
              "as": "meanGoals"
            },
            {
              "op": "count",
              "as": "runs"
            }
          ],
          "groupby": [
            "model",
            "harness",
            "env",
            "hosts"
          ]
        },
        {
          "calculate": "datum.env + ' (' + datum.hosts + ')'",
          "as": "envLabel"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 110,
        "opacity": 0.75
      },
      "encoding": {
        "x": {
          "field": "meanCost",
          "type": "quantitative",
          "title": "Mean cost per run ($)",
          "scale": {
            "zero": true
          },
          "axis": {
            "format": "$,.2f"
          }
        },
        "y": {
          "field": "meanGoals",
          "type": "quantitative",
          "title": "Mean % of goals achieved",
          "scale": {
            "domain": [
              0,
              100
            ]
          }
        },
        "color": {
          "field": "model",
          "type": "nominal",
          "title": "Model",
          "sort": [
            "GLM 5.2",
            "Kimi K3",
            "Qwen 3.8 Max"
          ]
        },
        "shape": {
          "field": "harness",
          "type": "nominal",
          "title": "Harness",
          "scale": {
            "domain": [
              "Incalmo",
              "Artemis",
              "Shell"
            ],
            "range": [
              "circle",
              "triangle-up",
              "square"
            ]
          }
        },
        "tooltip": [
          {
            "field": "model",
            "title": "Model"
          },
          {
            "field": "harness",
            "title": "Harness"
          },
          {
            "field": "envLabel",
            "title": "Environment"
          },
          {
            "field": "meanCost",
            "type": "quantitative",
            "format": "$,.2f",
            "title": "Mean cost / run"
          },
          {
            "field": "meanGoals",
            "type": "quantitative",
            "format": ".1f",
            "title": "Mean % goals achieved"
          },
          {
            "field": "runs",
            "type": "quantitative",
            "title": "Runs"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "harness": "Artemis",
            "px": 6.227,
            "py": 94.0
          },
          {
            "harness": "Incalmo",
            "px": 0.788,
            "py": 94.0
          },
          {
            "harness": "Shell",
            "px": 2.629,
            "py": 94.0
          }
        ]
      },
      "mark": {
        "type": "text",
        "dy": -8,
        "baseline": "bottom",
        "fontSize": 12,
        "fontWeight": 700
      },
      "encoding": {
        "x": {
          "field": "px",
          "type": "quantitative"
        },
        "y": {
          "field": "py",
          "type": "quantitative"
        },
        "text": {
          "field": "harness",
          "type": "nominal"
        }
      }
    }
  ]
}
