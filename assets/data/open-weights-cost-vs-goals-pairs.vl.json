{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "/assets/data/open-weights-runs.json"
  },
  "transform": [
    {
      "filter": "isValid(datum.cost)"
    }
  ],
  "spacing": 18,
  "facet": {
    "field": "model",
    "type": "nominal",
    "title": null,
    "sort": [
      "GLM 5.2",
      "Kimi K3",
      "Qwen 3.8 Max"
    ],
    "columns": 3,
    "header": {
      "labelFontSize": 13,
      "labelFontWeight": 700,
      "labelAnchor": "middle"
    }
  },
  "spec": {
    "width": 240,
    "height": 300,
    "layer": [
      {
        "transform": [
          {
            "aggregate": [
              {
                "op": "mean",
                "field": "cost",
                "as": "meanCost"
              },
              {
                "op": "stdev",
                "field": "cost",
                "as": "stdCost"
              },
              {
                "op": "mean",
                "field": "exfiltrated",
                "as": "meanGoals"
              },
              {
                "op": "stdev",
                "field": "exfiltrated",
                "as": "stdGoals"
              },
              {
                "op": "count",
                "as": "runs"
              }
            ],
            "groupby": [
              "model",
              "harness"
            ]
          },
          {
            "calculate": "max(0, datum.meanCost - datum.stdCost)",
            "as": "x0"
          },
          {
            "calculate": "datum.meanCost + datum.stdCost",
            "as": "x1"
          },
          {
            "calculate": "max(0, datum.meanGoals - datum.stdGoals)",
            "as": "y0"
          },
          {
            "calculate": "min(100, datum.meanGoals + datum.stdGoals)",
            "as": "y1"
          }
        ],
        "mark": {
          "type": "rect",
          "opacity": 0.22,
          "strokeWidth": 1
        },
        "encoding": {
          "x": {
            "field": "x0",
            "type": "quantitative"
          },
          "x2": {
            "field": "x1"
          },
          "y": {
            "field": "y0",
            "type": "quantitative"
          },
          "y2": {
            "field": "y1"
          },
          "color": {
            "field": "harness",
            "type": "nominal",
            "title": "Harness",
            "sort": [
              "Incalmo",
              "Artemis",
              "Shell"
            ],
            "legend": {
              "orient": "bottom",
              "direction": "horizontal",
              "columns": 0
            }
          },
          "stroke": {
            "field": "harness",
            "type": "nominal",
            "sort": [
              "Incalmo",
              "Artemis",
              "Shell"
            ],
            "legend": null
          },
          "tooltip": [
            {
              "field": "model",
              "title": "Model"
            },
            {
              "field": "harness",
              "title": "Harness"
            },
            {
              "field": "meanCost",
              "type": "quantitative",
              "format": "$,.2f",
              "title": "Mean cost / run"
            },
            {
              "field": "meanGoals",
              "type": "quantitative",
              "format": ".1f",
              "title": "Mean % goals achieved"
            },
            {
              "field": "runs",
              "type": "quantitative",
              "title": "Runs"
            }
          ]
        }
      },
      {
        "transform": [
          {
            "aggregate": [
              {
                "op": "mean",
                "field": "cost",
                "as": "meanCost"
              },
              {
                "op": "mean",
                "field": "exfiltrated",
                "as": "meanGoals"
              },
              {
                "op": "count",
                "as": "runs"
              }
            ],
            "groupby": [
              "model",
              "harness",
              "env",
              "hosts"
            ]
          },
          {
            "calculate": "datum.env + ' (' + datum.hosts + ')'",
            "as": "envLabel"
          }
        ],
        "mark": {
          "type": "point",
          "filled": true,
          "size": 70,
          "opacity": 0.8
        },
        "encoding": {
          "x": {
            "field": "meanCost",
            "type": "quantitative",
            "title": "Cost",
            "scale": {
              "zero": true
            },
            "axis": {
              "format": "$,.0f",
              "tickCount": 4
            }
          },
          "y": {
            "field": "meanGoals",
            "type": "quantitative",
            "title": "% goals achieved",
            "scale": {
              "domain": [
                0,
                100
              ]
            }
          },
          "color": {
            "field": "harness",
            "type": "nominal",
            "title": "Harness",
            "sort": [
              "Incalmo",
              "Artemis",
              "Shell"
            ],
            "legend": {
              "orient": "bottom",
              "direction": "horizontal",
              "columns": 0
            }
          },
          "tooltip": [
            {
              "field": "model",
              "title": "Model"
            },
            {
              "field": "harness",
              "title": "Harness"
            },
            {
              "field": "envLabel",
              "title": "Environment"
            },
            {
              "field": "meanCost",
              "type": "quantitative",
              "format": "$,.2f",
              "title": "Mean cost / run"
            },
            {
              "field": "meanGoals",
              "type": "quantitative",
              "format": ".1f",
              "title": "Mean % goals achieved"
            },
            {
              "field": "runs",
              "type": "quantitative",
              "title": "Runs"
            }
          ]
        }
      }
    ]
  },
  "_fitPanels": 3
}
