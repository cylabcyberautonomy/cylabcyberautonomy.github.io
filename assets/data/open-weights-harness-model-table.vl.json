            "domain": false
          }
        },
        "y": {
          "field": "harness",
          "type": "nominal",
          "title": null,
          "sort": [
            "Incalmo",
            "Shell",
            "Artemis"
          ],
          "axis": {
            "domain": false
          }
        },
        "text": {
          "field": "meanGoals",
          "type": "quantitative",
          "format": ".1f"
        },
        "color": {
          "condition": {
            "test": "datum.isBest",
            "value": "$ink-on-seq-high"
          },
          "value": "$ink-on-seq-low"
        }
      }
    }
  ],
  "_minMobileWidth": 430
}
