          ],
          "value": "$seq-0"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.colPos === 'first' && datum.rowPos === 'last'"
        }
      ],
      "mark": {
        "type": "rect",
        "stroke": "$ink-dim",
        "strokeWidth": 1,
        "cornerRadiusBottomLeft": 10
      },
      "encoding": {
        "x": {
          "field": "model",
          "type": "nominal",
          "title": null,
          "sort": [
