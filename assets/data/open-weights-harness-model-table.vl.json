{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "/assets/data/open-weights-runs.json"
  },
  "transform": [
    {
      "filter": "isValid(datum.exfiltrated)"
    },
    {
      "aggregate": [
        {
          "op": "mean",
          "field": "exfiltrated",
          "as": "meanGoals"
        },
        {
          "op": "count",
          "as": "runs"
        }
      ],
      "groupby": [
        "harness",
        "model"
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "meanGoals",
          "as": "rowMax"
        }
      ],
      "groupby": [
        "harness"
      ]
    },
    {
      "calculate": "datum.meanGoals >= datum.rowMax - 0.0001",
      "as": "isBest"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "meanGoals",
          "as": "tableMax"
        }
      ]
    },
    {
      "calculate": "datum.meanGoals >= datum.tableMax - 0.0001",
      "as": "isTop"
    },
    {
      "calculate": "datum.model === 'Kimi K3' ? 'first' : datum.model === 'Qwen 3.8 Max' ? 'last' : 'mid'",
      "as": "colPos"
    },
    {
      "calculate": "datum.harness === 'Incalmo' ? 'first' : datum.harness === 'Artemis' ? 'last' : 'mid'",
      "as": "rowPos"
    }
  ],
  "width": "container",
  "height": 170,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "layer": [
    {
      "transform": [
        {
          "filter": "!((datum.colPos === 'first' && datum.rowPos === 'first') || (datum.colPos === 'last' && datum.rowPos === 'first') || (datum.colPos === 'first' && datum.rowPos === 'last') || (datum.colPos === 'last' && datum.rowPos === 'last'))"
        }
      ],
      "mark": {
        "type": "rect",
        "stroke": "$ink-dim",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "model",
          "type": "nominal",
          "title": null,
          "sort": [
            "Kimi K3",
            "GLM 5.2",
            "Qwen 3.8 Max"
          ],
          "axis": {
            "orient": "top",
            "labelAngle": 0,
            "labelFontWeight": 700,
            "domain": false
          }
        },
        "y": {
          "field": "harness",
          "type": "nominal",
          "title": null,
          "sort": [
            "Incalmo",
            "Shell",
            "Artemis"
          ],
          "axis": {
            "labelFontWeight": 700,
            "domain": false
          }
        },
        "color": {
          "condition": [
            {
              "test": "datum.isTop",
              "value": "$seq-100"
            },
            {
              "test": "datum.isBest",
              "value": "$seq-75"
            }
          ],
          "value": "$seq-0"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.colPos === 'first' && datum.rowPos === 'first'"
        }
      ],
      "mark": {
        "type": "rect",
        "stroke": "$ink-dim",
        "strokeWidth": 1,
        "cornerRadiusTopLeft": 10
      },
      "encoding": {
        "x": {
          "field": "model",
          "type": "nominal",
          "title": null,
          "sort": [
            "Kimi K3",
            "GLM 5.2",
            "Qwen 3.8 Max"
          ],
          "axis": {
            "orient": "top",
            "labelAngle": 0,
            "labelFontWeight": 700,
            "domain": false
          }
        },
        "y": {
          "field": "harness",
          "type": "nominal",
          "title": null,
          "sort": [
            "Incalmo",
            "Shell",
            "Artemis"
          ],
          "axis": {
            "labelFontWeight": 700,
            "domain": false
          }
        },
        "color": {
          "condition": [
            {
              "test": "datum.isTop",
              "value": "$seq-100"
            },
            {
              "test": "datum.isBest",
              "value": "$seq-75"
            }
          ],
          "value": "$seq-0"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.colPos === 'last' && datum.rowPos === 'first'"
        }
      ],
      "mark": {
        "type": "rect",
        "stroke": "$ink-dim",
        "strokeWidth": 1,
        "cornerRadiusTopRight": 10
      },
      "encoding": {
        "x": {
          "field": "model",
          "type": "nominal",
          "title": null,
          "sort": [
            "Kimi K3",
